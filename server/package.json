{
  "name": "vidify",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node src/app.js",
    "dev": "tsx watch -r tsconfig-paths/register src/app.ts",
    "swagger": "tsx watch -r tsconfig-paths/register src/http/swagger.ts",
    "knex": "npx tsx ./node_modules/knex/bin/cli.js",
    "knex:migrate:make": "npm run knex migrate:make",
    "knex:migrate:latest": "npm run knex migrate:latest",
    "knex:migrate:rollback": "npm run knex migrate:rollback",
    "knex:migrate:status": "npm run knex migrate:status",
    "knex:seed:run": "npm run knex seed:run",
    "compose": "docker compose -f docker-compose.dev.yaml up --build -d"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.744.0",
    "@aws-sdk/client-s3": "^3.744.0",
    "@aws-sdk/s3-request-presigner": "^3.744.0",
    "@google/generative-ai": "^0.21.0",
    "ass-compiler": "^0.1.15",
    "axios": "^1.7.9",
    "bullmq": "^5.40.2",
    "chalk": "^5.4.1",
    "claude-ai": "^1.2.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.0",
    "ioredis": "^5.5.0",
    "jimp": "^1.6.0",
    "knex": "^3.1.0",
    "mysql": "^2.18.1",
    "node-cron": "^3.0.3",
    "openai": "^4.83.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-sdk": "^2.7.4",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.7",
    "puppeteer": "^24.2.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
